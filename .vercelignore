# Pastas pesadas que NAO devem ir pro upload do Vercel
# (Vercel reinstala node_modules e gera .next no servidor)
**/node_modules
**/.next
**/dist
**/build

# Cache Python
**/__pycache__
**/*.pyc
**/.pytest_cache
**/.venv
**/venv

# Git e ferramentas
.git
.gitignore
.claude
.vscode
.idea

# Documentacao e dev local
*.md
PROGRESSO.md
ONBOARDING.md
/docs/
/test/
/tests/

# Logs e arquivos temporarios
*.log
.DS_Store
Thumbs.db

# Migrations rodam manual no Supabase Editor — nao precisam estar no deploy
# (barra inicial ancora na RAIZ — nao afeta frontend/src/utils/supabase/)
/supabase/

# Backups
*.bak
*.swp
*.tmp

# Ficam no repositorio, mas nao servem em producao. Antes subiam junto a cada
# deploy: `scripts/` sao utilitarios de manutencao e `graphify-out/` e o mapa
# do projeto, ambos sem nenhum leitor em runtime.
# `static/plano_contas.json` NAO entra aqui — `load_plano_contas()` le ele.
/scripts/
/graphify-out/
